{
    "meta": {
        "label": "Linkup Search",
        "description": "Recipe to perform a search using the Linkup search engine",
        "icon": "icon-puzzle-piece"
    },
    "kind": "PYTHON",
    "selectableFromDataset": "input_dataset",
    "inputRoles": [
        {
            "name": "input_dataset",
            "label": "Input Dataset",
            "description": "Dataset with a text column to translate",
            "arity": "UNARY",
            "required": true,
            "acceptsDataset": true
        }
    ],
    "outputRoles": [
        {
            "name": "output_dataset",
            "label": "Output dataset",
            "description": "Dataset with text translated to another language",
            "arity": "UNARY",
            "required": true,
            "acceptsDataset": true
        }
    ],
    "params": [
        {
            "name": "depth",
            "label": "Depth",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": "standard",
                    "label": "standard"
                },
                {
                    "value": "deep",
                    "label": "deep"
                }
            ],
            "defaultValue": "standard",
            "mandatory": true
        },
        {
            "name": "api_key",
            "label": "Linkup API key",
            "type": "STRING",
            "defaultValue": "",
            "mandatory": true
        },
        {
            "name": "query_column",
            "label": "Column containing the query text",
            "type": "COLUMN",
            "defaultValue": "query",
            "mandatory": true
        },
        {
            "name": "output_format",
            "label": "Output format",
            "type": "SELECT",
            "selectChoices": [
                {
                    "value": "text",
                    "label": "Text"
                },
                {
                    "value": "structured",
                    "label": "Structured (JSON)"
                }
            ],
            "mandatory": true
        },
        {
            "name": "structured_output_format",
            "label": "Structured output format (JSON)",
            "type": "TEXTAREA",
            "visibilityCondition": "model.output_format == 'structured'"
        }
    ],
    "resourceKeys": []
}